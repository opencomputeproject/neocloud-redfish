{
  "SchemaDefinition": "RedfishInteroperabilityProfile.v1_10_0",
  "ProfileName": "OCPNeocloudAccelerator",
  "ProfileVersion": "0.6.0",
  "Purpose": "Neocloud accelerator tier. Applies to systems with GPU/accelerator Processors, whether the accelerator management controller's Redfish model is aggregated by the host BMC (NVIDIA HGX via Supermicro) or the BMC models the GPUs itself (Dell iDRAC). Composes OCP_UBB_BaselineManagement 2.0.0 (OCP System GPU Management workstream; being renamed from UBB) and adds the RAS content ClusterMAX Reliability and Monitoring weight most: HBM ECC, PCIe AER and link width, throttle durations, NVLink port health, active conditions, accelerator-subsystem liveness, and a conditional bulk-telemetry contract. Requirements are scoped to accelerator Processors by UseCase so host CPUs are not tested against them.",
  "OwningEntity": "Open Compute Project",
  "ContributedBy": "OCP Scaling AI Clusters at Neoclouds workgroup (DRAFT); evidence from the reference collector",
  "ContactInfo": "OCP FTI Scaling AI Clusters at Neoclouds workstream",
  "ProfileType": "Interop",
  "RequiredProfiles": {
    "OCPNeocloudServiceCore": {
      "MinVersion": "0.6.0"
    },
    "OCP_UBB_BaselineManagement": {
      "MinVersion": "2.0.0",
      "Repository": "github.com/opencomputeproject/ocp-hm-system-gpu-management/profiles"
    }
  },
  "Protocol": {
    "MinVersion": "1.15",
    "ExpandQuery": "Recommended"
  },
  "Resources": {
    "Processor": {
      "UseCases": [
        {
          "ReadRequirement": "Mandatory",
          "UseCaseTitle": "Accelerator Processor",
          "UseCaseKeyProperty": "ProcessorType",
          "UseCaseKeyValues": [
            "GPU",
            "Accelerator"
          ],
          "UseCaseComparison": "AnyOf",
          "PropertyRequirements": {
            "ProcessorType": {
              "ReadRequirement": "Mandatory"
            },
            "Manufacturer": {
              "ReadRequirement": "Mandatory"
            },
            "Model": {
              "ReadRequirement": "Mandatory"
            },
            "SerialNumber": {
              "ReadRequirement": "Recommended"
            },
            "PartNumber": {
              "ReadRequirement": "Recommended"
            },
            "Metrics": {
              "ReadRequirement": "Mandatory",
              "Purpose": "Raised from UBB Recommended: the GPU telemetry link must exist. Present on both fleet platforms [rec]."
            },
            "EnvironmentMetrics": {
              "ReadRequirement": "Mandatory"
            },
            "MemorySummary": {
              "ReadRequirement": "Mandatory",
              "PropertyRequirements": {
                "Metrics": {
                  "ReadRequirement": "Mandatory",
                  "Purpose": "Link to the HBM MemoryMetrics for this accelerator (Dell shape) [rec]. HMC shape links HBM as Memory members of the accelerator baseboard system."
                }
              }
            },
            "Status": {
              "ReadRequirement": "Mandatory",
              "PropertyRequirements": {
                "Health": {
                  "ReadRequirement": "Mandatory"
                },
                "State": {
                  "ReadRequirement": "Mandatory",
                  "Purpose": "A device that left the PCIe bus shall not remain Enabled/OK: report UnavailableOffline or Absent (DSP0266 s9.11). A node with 4 of 8 GPUs off the bus reported 8 GPUs Enabled/OK [rec]; today the only OOB tell is PCIeInterface.LanesInUse=0 [live]."
                },
                "Conditions": {
                  "ReadRequirement": "Recommended"
                }
              }
            },
            "Ports": {
              "ReadRequirement": "Recommended",
              "Purpose": "NVLink ports. Mandatory in OCP_UBB_BaselineManagement (inherited). Dell iDRAC9 7.20 models NVLink state in Oem.Dell on ProcessorMetrics instead of Ports [rec] - the gap to raise with Dell."
            },
            "Links": {
              "ReadRequirement": "Recommended",
              "PropertyRequirements": {
                "PCIeDevice": {
                  "ReadRequirement": "Recommended"
                },
                "Chassis": {
                  "ReadRequirement": "Recommended"
                }
              }
            },
            "SystemInterface": {
              "ReadRequirement": "Recommended",
              "PropertyRequirements": {
                "PCIe": {
                  "ReadRequirement": "Recommended",
                  "PropertyRequirements": {
                    "PCIeType": {
                      "ReadRequirement": "Recommended"
                    },
                    "MaxLanes": {
                      "ReadRequirement": "Recommended"
                    },
                    "MaxPCIeType": {
                      "ReadRequirement": "Recommended"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ProcessorMetrics": {
      "UseCases": [
        {
          "ReadRequirement": "Mandatory",
          "UseCaseTitle": "Accelerator ProcessorMetrics",
          "UseCaseType": "ProcessorType",
          "UseCaseKeyValues": [
            "GPU",
            "Accelerator"
          ],
          "UseCaseComparison": "AnyOf",
          "Purpose": "Standard-schema GPU RAS. The NVIDIA HMC surface provides 14 of the 15 paths below [rec: Supermicro HGX B200]; iDRAC9 7.20 provides BandwidthPercent, OperatingSpeedMHz and CorrectableErrorCount only, carrying the rest in Oem.Dell/Oem.Nvidia [rec: Dell XE9680].",
          "PropertyRequirements": {
            "BandwidthPercent": {
              "ReadRequirement": "Mandatory"
            },
            "OperatingSpeedMHz": {
              "ReadRequirement": "Mandatory"
            },
            "PCIeErrors": {
              "ReadRequirement": "Mandatory",
              "Purpose": "PCIe AER: link instability and 'fell off the bus' [gap 2.1].",
              "PropertyRequirements": {
                "CorrectableErrorCount": {
                  "ReadRequirement": "Mandatory"
                },
                "NonFatalErrorCount": {
                  "ReadRequirement": "Mandatory"
                },
                "FatalErrorCount": {
                  "ReadRequirement": "Mandatory"
                },
                "L0ToRecoveryCount": {
                  "ReadRequirement": "Recommended"
                },
                "ReplayCount": {
                  "ReadRequirement": "Recommended"
                },
                "ReplayRolloverCount": {
                  "ReadRequirement": "Recommended"
                },
                "NAKSentCount": {
                  "ReadRequirement": "Recommended"
                },
                "NAKReceivedCount": {
                  "ReadRequirement": "Recommended"
                },
                "UnsupportedRequestCount": {
                  "ReadRequirement": "Recommended"
                }
              }
            },
            "PCIeInterface": {
              "ReadRequirement": "Recommended",
              "Purpose": "Negotiated link. LanesInUse=0 on all 8 GPUs of one node and on one GPU of another is the live 'GPU fell off the bus' signature, visible with no host agent [live: A1-96, A1-101].",
              "PropertyRequirements": {
                "LanesInUse": {
                  "ReadRequirement": "Mandatory"
                },
                "MaxLanes": {
                  "ReadRequirement": "Mandatory"
                },
                "PCIeType": {
                  "ReadRequirement": "Recommended"
                },
                "MaxPCIeType": {
                  "ReadRequirement": "Recommended"
                }
              }
            },
            "PowerLimitThrottleDuration": {
              "ReadRequirement": "Recommended",
              "Purpose": "Power-cap throttling is normal under a cap; sustained thermal or hardware-violation throttling is a fault. Durations are ISO 8601 strings on the HMC [rec]."
            },
            "ThermalLimitThrottleDuration": {
              "ReadRequirement": "Recommended"
            },
            "ThrottlingCelsius": {
              "ReadRequirement": "Recommended",
              "Purpose": "Not provided by any platform in the fleet [rec]."
            },
            "CacheMetricsTotal": {
              "ReadRequirement": "Recommended",
              "PropertyRequirements": {
                "LifeTime": {
                  "ReadRequirement": "Mandatory",
                  "PropertyRequirements": {
                    "CorrectableECCErrorCount": {
                      "ReadRequirement": "Mandatory"
                    },
                    "UncorrectableECCErrorCount": {
                      "ReadRequirement": "Mandatory"
                    }
                  }
                }
              }
            },
            "TemperatureCelsius": {
              "ReadRequirement": "Recommended"
            },
            "ConsumedPowerWatt": {
              "ReadRequirement": "Recommended"
            }
          }
        }
      ]
    },
